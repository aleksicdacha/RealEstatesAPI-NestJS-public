{
  "info": {
    "name": "Real Estate API",
    "description": "Complete API collection for Real Estate Management System",
    "version": "2.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "property_guid",
      "value": "",
      "type": "string"
    },
    {
      "key": "client_guid",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const responseJson = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', responseJson.access_token);",
                  "    console.log('Token saved:', responseJson.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with username and password. Token is automatically saved."
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user account"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Logout current user (requires authentication)"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Request password reset email"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"reset-token-here\",\n  \"password\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Reset password with token from email"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"your-refresh-token-here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh-token"]
            },
            "description": "Get new access token using refresh token"
          }
        }
      ]
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "Get All Properties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/properties?page=1&limit=10&sortBy=createdAt&order=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["properties"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt"
                },
                {
                  "key": "order",
                  "value": "DESC"
                },
                {
                  "key": "searchField",
                  "value": "address",
                  "disabled": true
                },
                {
                  "key": "searchValue",
                  "value": "New York",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "Active",
                  "disabled": true
                },
                {
                  "key": "propertyType",
                  "value": "Apartment",
                  "disabled": true
                }
              ]
            },
            "description": "Get paginated list of properties with optional filtering"
          }
        },
        {
          "name": "Get Property by GUID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/properties/{{property_guid}}",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "{{property_guid}}"]
            },
            "description": "Get specific property details by GUID"
          }
        },
        {
          "name": "Create Property",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const responseJson = pm.response.json();",
                  "    pm.collectionVariables.set('property_guid', responseJson.guid);",
                  "    console.log('Property created with GUID:', responseJson.guid);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"PROP-{{$timestamp}}\",\n  \"description\": \"Beautiful apartment in downtown\",\n  \"propertyType\": \"Apartment\",\n  \"price\": 250000,\n  \"salePrice\": 230000,\n  \"area\": 120.5,\n  \"address\": \"123 Main Street, New York, NY\",\n  \"lat\": 40.7128,\n  \"lon\": -74.0060,\n  \"bathrooms\": 2,\n  \"floor\": 5,\n  \"elevator\": true,\n  \"constructionYear\": 2020,\n  \"heating\": \"Central\",\n  \"comment\": \"Great location with city view\",\n  \"additionalEquipment\": [\"Balcony\", \"Parking\", \"Air Conditioning\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/properties",
              "host": ["{{baseUrl}}"],
              "path": ["properties"]
            },
            "description": "Create a new property. Property GUID is automatically saved."
          }
        },
        {
          "name": "Update Property",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"PROP-UPDATED\",\n  \"description\": \"Updated: Beautiful apartment in downtown with renovated kitchen\",\n  \"propertyType\": \"Apartment\",\n  \"price\": 260000,\n  \"salePrice\": 240000,\n  \"area\": 120.5,\n  \"address\": \"123 Main Street, New York, NY\",\n  \"lat\": 40.7128,\n  \"lon\": -74.0060,\n  \"bathrooms\": 2,\n  \"floor\": 5,\n  \"elevator\": true,\n  \"constructionYear\": 2020,\n  \"heating\": \"Central\",\n  \"comment\": \"Great location with city view and renovated kitchen\",\n  \"additionalEquipment\": [\"Balcony\", \"Parking\", \"Air Conditioning\", \"Dishwasher\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/properties/{{property_guid}}",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "{{property_guid}}"]
            },
            "description": "Update existing property (full update with PUT)"
          }
        },
        {
          "name": "Delete Property",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/properties/{{property_guid}}",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "{{property_guid}}"]
            },
            "description": "Delete a property by GUID"
          }
        }
      ]
    },
