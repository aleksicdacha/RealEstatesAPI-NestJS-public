{
  "name": "real-estate-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:admin": "cd apps/admin-web && npm run dev",
    "dev:user": "cd apps/user-web && npm run dev",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "fresh-start": "./fresh-start.sh",
    "seed": "npx ts-node --project tsconfig.seed.json -r tsconfig-paths/register seeds/seed.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0",
    "@types/node": "^20.17.10",
    "@types/bcrypt": "^5.0.2"
  },
  "dependencies": {
    "react-google-recaptcha": "^3.1.0",
    "bcrypt": "^5.1.1",
    "typeorm": "^0.3.21",
    "pg": "^8.13.1",
    "dotenv": "^16.4.7"
  },
  "overrides": {
    "socket.io-parser": "4.2.6"
  }
}
