{
  "name": "real-estate-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:admin": "cd apps/admin-web && npm run dev",
    "dev:user": "cd apps/user-web && npm run dev",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "fresh-start": "./fresh-start.sh",
    "seed": "npx ts-node --project tsconfig.seed.json -r tsconfig-paths/register seeds/seed.ts",
    "seed:force": "npx ts-node --project tsconfig.seed.json -r tsconfig-paths/register seeds/seed.ts --force",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:api": "dotenv -e .env.test -- playwright test --project=api",
    "test:e2e:admin": "dotenv -e .env.test -- playwright test --project=admin-web",
    "test:e2e:user": "dotenv -e .env.test -- playwright test --project=user-web",
    "test:e2e:browser": "dotenv -e .env.test -- playwright test --project=admin-web --project=user-web --no-deps",
    "test:e2e:browser:headed": "dotenv -e .env.test -- playwright test --project=admin-web --project=user-web --headed --no-deps",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:e2e:headed": "dotenv -e .env.test -- playwright test --headed",
    "test:e2e:report": "playwright show-report e2e/reports"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.17.10",
    "babel-plugin-istanbul": "^8.0.2",
    "dotenv-cli": "^11.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "react-google-recaptcha": "^3.1.0",
    "typeorm": "^0.3.21"
  },
  "overrides": {
    "socket.io-parser": "4.2.6",
    "multer": "2.1.1",
    "glob": "^10.5.0",
    "lodash": "^4.17.23",
    "tar": "^7.5.3",
    "picomatch": "^4.0.4",
    "tmp": "^0.2.4",
    "test-exclude": "^7.0.1",
    "@swc/helpers": "^0.5.21",
    "fast-safe-stringify": "2.1.1"
  }
}
