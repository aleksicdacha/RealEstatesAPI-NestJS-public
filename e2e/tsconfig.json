{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@e2e/fixtures": ["./fixtures/index.ts"],
      "@e2e/utils/*": ["./utils/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules", "../apps", "../packages", "reports", "test-results", ".auth"]
}
