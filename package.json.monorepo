{
  "name": "real-estate-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Real Estate Platform - Monorepo with NestJS API and Next.js Frontends",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "cd src && npx ts-node main.ts",
    "api:start": "npm install && npm run migration:run && node dist/main",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=api",
    "dev:admin": "turbo run dev --filter=admin-web",
    "dev:user": "turbo run dev --filter=user-web",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=api",
    "build:admin": "turbo run build --filter=admin-web",
    "build:user": "turbo run build --filter=user-web",
    "start": "turbo run start",
    "start:api": "turbo run start --filter=api",
    "start:admin": "turbo run start --filter=admin-web",
    "start:user": "turbo run start --filter=user-web",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/common": "^11.1.10",
    "@nestjs/core": "^11.1.10",
    "@nestjs/platform-express": "^11.1.10",
    "prettier": "^3.3.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
